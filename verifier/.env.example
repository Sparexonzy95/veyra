# Independent verifier runtime. Keep this key only on the verifier machine.
AI_PROVIDER=aiand
AI_MODEL=zai-org/glm-5.2
AI_BASE_URL=https://api.aiand.com/v1
AI_API_KEY=PASTE_SEPARATE_VERIFIER_PAID_KEY_HERE
AI_HEALTHCHECK_MODE=live
VEYRA_HEARTBEAT_SECONDS=10
# Optional: keep disposable repository workspaces away from runtime identity
# and provider-secret files. Defaults to an isolated system-temp directory.
VEYRA_RUNTIME_WORKSPACE_ROOT=
VEYRA_MODEL_TIMEOUT_SECONDS=240
VEYRA_MODEL_CONTEXT_CHARACTERS=180000
GITHUB_API_URL=https://api.github.com
