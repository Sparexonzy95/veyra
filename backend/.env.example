DJANGO_SECRET_KEY=replace-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://veyra:veyra@localhost:5432/veyra
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
VEYRA_COOKIE_SAMESITE=Lax

CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_APP_ID=
CIRCLE_BASE_URL=https://api.circle.com

ARC_RPC_URL=https://rpc.testnet.arc.network
# Optional priority-ordered pool. Commas or newlines are accepted. ARC_RPC_URL
# remains supported and public Arc Testnet fallbacks are appended automatically.
ARC_RPC_URLS=https://rpc.drpc.testnet.arc.network,https://rpc.quicknode.testnet.arc.network,https://rpc.blockdaemon.testnet.arc.network,https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_BLOCKCHAIN=ARC-TESTNET
VEYRA_CONTRACT_ADDRESS=0xe422ba48559A4ef5B1fad8A5AAc4F646b252d9F5
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_USDC_DECIMALS=6
VEYRA_VERIFIER_ADDRESS=0x0EdBC6F8506e72478CE78a4AE934C7b21cb7050A
ARC_INDEXER_START_BLOCK=0

GITHUB_TOKEN=
# Real GitHub App configuration
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Use a single-line value with literal \n between PEM lines.
GITHUB_APP_PRIVATE_KEY=
# Recommended: path to the downloaded .pem file outside this repository.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_INSTALL_URL=
GITHUB_APP_TIMEOUT_SECONDS=20
GITHUB_APP_STATE_TTL_SECONDS=900
VEYRA_FRONTEND_URL=http://localhost:3000

# Circle developer-controlled worker wallet
WORKER_CIRCLE_WALLET_SET_NAME=Veyra Worker Agents

# Worker coding engine (no API key is stored in Django)
WORKER_ENGINE_EXECUTABLE=opencode
WORKER_ENGINE_HEALTHCHECK_ARGS=--version
WORKER_ENGINE_TIMEOUT_SECONDS=20
WORKER_ENGINE_MODEL=zai-org/glm-5.2
WORKER_DISCOVERY_MIN_REMAINING_SECONDS=900
WORKER_DISCOVERY_REQUIRE_SKILL_MATCH=true
WORKER_CLAIM_FEE_LEVEL=MEDIUM
WORKER_CLAIM_TIMEOUT_SECONDS=180
WORKER_CLAIM_POLL_INTERVAL_SECONDS=3
WORKER_ARC_RECEIPT_TIMEOUT_SECONDS=120
WORKER_EXECUTION_MIN_REMAINING_SECONDS=900
WORKER_JOB_TEST_TIMEOUT_SECONDS=900
WORKER_SUBMISSION_MIN_REMAINING_SECONDS=120
WORKER_SUBMISSION_FEE_LEVEL=MEDIUM
WORKER_SUBMISSION_TIMEOUT_SECONDS=180
WORKER_SUBMISSION_POLL_INTERVAL_SECONDS=3

LOG_LEVEL=INFO

# Owner-hosted agent connection
VEYRA_PUBLIC_API_URL=http://127.0.0.1:8000
VEYRA_ALLOW_LOCAL_AGENT_RUNTIME=True
VEYRA_AGENT_CONNECTION_PROTOCOL_VERSION=1
VEYRA_AGENT_CONNECTION_TIMEOUT_SECONDS=20
VEYRA_AGENT_RUNTIME_ONLINE_WINDOW_SECONDS=35
VEYRA_QUALIFICATION_MAX_AGE_DAYS=30

# Original Arc Testnet deployer EOA that owns VeyraJobEscrow.
# Keep the private key server-side only. Never expose it to the frontend.
VEYRA_CONTRACT_OWNER_WALLET_ADDRESS=0x0EdBC6F8506e72478CE78a4AE934C7b21cb7050A
VEYRA_CONTRACT_OWNER_PRIVATE_KEY=
VEYRA_CONTRACT_AUTHORISATION_FEE_LEVEL=MEDIUM
VEYRA_CONTRACT_AUTHORISATION_TIMEOUT_SECONDS=180
VEYRA_CONTRACT_AUTHORISATION_POLL_INTERVAL_SECONDS=3

# Automatic execution layer
# For the current MVP deployment this may be the same authorised deployer key.
VEYRA_VERIFIER_PRIVATE_KEY=
VEYRA_JOB_RESERVATION_SECONDS=90
VEYRA_MATCHING_FAIRNESS_BAND=200
VEYRA_JOB_LEASE_GRACE_SECONDS=120
VEYRA_JOB_MAX_REPAIR_ATTEMPTS=2
VEYRA_REQUIRE_GITHUB_CHECKS=True
VEYRA_VERIFIER_RESERVATION_SECONDS=90
VEYRA_VERIFIER_LEASE_MINUTES=30
VEYRA_SETTLEMENT_TIMEOUT_SECONDS=180
VEYRA_SETTLEMENT_POLL_INTERVAL_SECONDS=3
